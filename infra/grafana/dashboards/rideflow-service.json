          "expr": "histogram_quantile(0.5, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{job=~\"rideflow-backend.*\", uri!~\"/actuator.*|/livez|/readyz\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
