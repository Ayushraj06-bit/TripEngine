      },
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      }
    },
    {
      "type": "timeseries",
      "title": "GC pause time per second",
      "description": "Seconds paused per second of wall time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gc) (rate(jvm_gc_pause_seconds_sum{job=~\"rideflow-backend.*\"}[$__rate_interval]))",
          "legendFormat": "{{gc}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
