      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (db_operation) (rate(lettuce_seconds_count{job=~\"rideflow-backend.*\"}[$__rate_interval]))",
          "legendFormat": "{{db_operation}}",
          "refId": "A"
