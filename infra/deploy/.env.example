# Copy to infra/deploy/.env and fill in. Compose reads it from there on its own.

# The DNS name pointing at this VM: Caddy's certificate is for it, and so is the tokens' issuer.
RIDEFLOW_DOMAIN=rideflow.example.com

# The first admin, created on the first start; the password is in the secrets directory.
RIDEFLOW_ADMIN_PHONE=+91XXXXXXXXXX

# Optional: another image tag, or another place for the secrets.
# RIDEFLOW_IMAGE=ghcr.io/ayushraj06-bit/rideflow-backend:phase-11
# RIDEFLOW_SECRETS=/etc/rideflow/secrets
